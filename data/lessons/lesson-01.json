  "content": {
    "can_do": [
      {
        "id": "l01-cd-01",
        "summary_en": "Can exchange greetings when meeting someone.",
        "summary_si": "කෙනෙකු හමුවූ විට සුදුසු ආචාර වචන භාවිතයෙන් ආචාර කළ හැකිය.",
        "example_ja": "こんにちは。",
        "romaji": "Konnichiwa.",
        "meaning_si": "ආයුබෝවන්."
      },
      {
        "id": "l01-cd-02",
        "summary_en": "Can say goodbye when leaving.",
        "summary_si": "ස්ථානයකින් පිටත්ව යන විට සමුගැනීමේ වචන භාවිත කළ හැකිය.",
        "example_ja": "お先に失礼します。",
        "romaji": "Osaki ni shitsurei shimasu.",
        "meaning_si": "මම කලින් යනවා / අවසරයි, මම පිටත් වෙනවා."
      },
      {
        "id": "l01-cd-03",
        "summary_en": "Can thank someone or apologize.",
        "summary_si": "ස්තුතිය පළ කිරීමට හෝ සමාව ඉල්ලීමට සරල ප්‍රකාශ භාවිත කළ හැකිය.",
        "example_ja": "ありがとうございます。",
        "romaji": "Arigatou gozaimasu.",
        "meaning_si": "බොහොම ස්තුතියි."
      },
      {
        "id": "l01-cd-04",
        "summary_en": "Can understand common message stickers such as good morning and thanks.",
        "summary_si": "සුභ උදෑසනක් සහ ස්තුතියි වැනි වචන සහිත පණිවිඩ ස්ටිකර් හඳුනාගත හැකිය.",
        "example_ja": "おはよう！",
        "romaji": "Ohayou!",
        "meaning_si": "සුභ උදෑසනක්!"
      }
    ],
