  "grammar_patterns": [
    {
      "id": "l03-grammar-01",
      "jp": "N です / N1 は N2 です",
      "romaji": "N desu / N1 wa N2 desu",
      "explanation_si": "නාම පදයකට පසුව です යෙදීමෙන් තමන් කවුදැයි හෝ කුමක්දැයි ආචාරශීලීව කියයි. は ලියන නමුත් wa ලෙස උච්චාරණය කරයි; වාක්‍යයේ මාතෘකාව දක්වයි.",
      "examples": [
        {
          "ja": "ラヒルです。",
          "romaji": "Rahir(u) desu.",
          "si": "මම ලහිරු."
        },
        {
          "ja": "私は会社員です。",
          "romaji": "Watashi wa kaishain desu.",
          "si": "මම සමාගම් සේවකයෙක්."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l03-grammar-02",
      "jp": "【place】から来ました",
      "romaji": "[place] kara kimashita",
      "explanation_si": "තමන් පැමිණි රට හෝ නගරය කියයි. ස්ථානයට පසුව から යොදයි. මේ පාඩමේදී ～から来ました යන ප්‍රකාශය එකට මතක තබාගන්න.",
      "examples": [
        {
          "ja": "スリランカから来ました。",
          "romaji": "Suriranka kara kimashita.",
          "si": "මම ශ්‍රී ලංකාවෙන් ආවා."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l03-grammar-03",
      "jp": "N は？",
      "romaji": "N wa?",
      "explanation_si": "කලින් කතා කළ මාතෘකාවම අනෙක් පුද්ගලයාගෙන් අසන කෙටි ප්‍රශ්නයකි. お名前は？ වැනි お/ご යෙදීමෙන් වඩාත් ගෞරවයෙන් අසයි.",
      "examples": [
        {
          "ja": "お名前は？",
          "romaji": "O-namae wa?",
          "si": "ඔබේ නම මොකක්ද?"
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l03-grammar-04",
      "jp": "S か？",
      "romaji": "S ka?",
      "explanation_si": "ප්‍රකාශ වාක්‍යයක අවසානයට か එක් කිරීමෙන් ප්‍රශ්නයක් කරයි. ඔබ කතා කරන කෙනාගේ නම දන්නවා නම් あなた වෙනුවට නමට さん යොදන්න.",
      "examples": [
        {
          "ja": "日本語がわかりますか？",
          "romaji": "Nihongo ga wakarimasu ka?",
          "si": "ජපන් භාෂාව තේරෙනවාද?"
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l03-grammar-05",
      "jp": "N も",
      "romaji": "N mo",
      "explanation_si": "も යනු 'ත් / ද' හෝ 'මමත්' යන අදහස දෙන particle එකකි.",
      "examples": [
        {
          "ja": "私もスリランカです。",
          "romaji": "Watashi mo Suriranka desu.",
          "si": "මමත් ශ්‍රී ලංකාවේ."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l03-grammar-06",
      "jp": "N じゃないです",
      "romaji": "N ja nai desu",
      "explanation_si": "නාම පද වාක්‍යයක නිෂේධන ආකාරයයි. N です වෙනුවට N じゃないです යොදයි. වඩාත් විධිමත් ආකාරය ではありません ය.",
      "examples": [
        {
          "ja": "学生じゃないです。",
          "romaji": "Gakusei ja nai desu.",
          "si": "මම ශිෂ්‍යයෙක් නොවේ."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    }
  ],
