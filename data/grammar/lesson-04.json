  "grammar_patterns": [
    {
      "id": "l04-grammar-01",
      "jp": "N1 と N2",
      "romaji": "N1 to N2",
      "explanation_si": "නාම පද දෙකක් හෝ කිහිපයක් 'සහ' ලෙස සම්බන්ධ කරයි. මෙහි පවුලේ සාමාජිකයන් හඳුන්වාදීමට භාවිතා වේ.",
      "examples": [
        {
          "ja": "父と母です。",
          "romaji": "Chichi to haha desu.",
          "si": "තාත්තා සහ අම්මා."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l04-grammar-02",
      "jp": "Interrogative + ですか",
      "romaji": "Question word + desu ka",
      "explanation_si": "何歳、いくつ、だれ、どこ වැනි ප්‍රශ්න පදයකට ですか එක් කර ප්‍රශ්නයක් සාදයි. වයස අසන විට 何歳ですか／おいくつですか යොදාගත හැක.",
      "examples": [
        {
          "ja": "おいくつですか？",
          "romaji": "Oikutsu desu ka?",
          "si": "ඔබගේ වයස කීයද?"
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l04-grammar-03",
      "jp": "【place】に住んでいます",
      "romaji": "[place] ni sunde imasu",
      "explanation_si": "කෙනෙකු ජීවත් වන ස්ථානය කියයි. රටක හෝ නගරයක නමට පසුව に යොදයි. 住んでいます යන්න මේ පාඩමේදී එකම වාක්‍ය රටාවක් ලෙස මතක තබාගන්න.",
      "examples": [
        {
          "ja": "マータラに住んでいます。",
          "romaji": "Ma-tara ni sunde imasu.",
          "si": "මම මාතර ජීවත් වෙනවා."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l04-grammar-04",
      "jp": "N1 の N2",
      "romaji": "N1 no N2",
      "explanation_si": "の මඟින් නාම පද දෙකක් අතර අයිතිය, සම්බන්ධතාව හෝ විස්තරය දක්වයි. 'මගේ පවුල', 'අක්කාගේ දරුවා' වැනි අදහස්. සමහර විට නාම දෙක එකම පුද්ගලයා/දේ හඳුන්වයි.",
      "examples": [
        {
          "ja": "私の家族です。",
          "romaji": "Watashi no kazoku desu.",
          "si": "මේ මගේ පවුලයි."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    }
  ],
