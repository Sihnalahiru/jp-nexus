      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l04-grammar-03",
      "jp": "【place】に住んでいます",
      "romaji": "[place] ni sunde imasu",
      "explanation_si": "කෙනෙකු ජීවත් වන ස්ථානය කියයි. රටක හෝ නගරයක නමට පසුව に යොදයි. 住んでいます යන්න මේ පාඩමේදී එකම වාක්‍ය රටාවක් ලෙස මතක තබාගන්න.",
      "examples": [
        {
          "ja": "マータラに住んでいます。",
          "romaji": "Ma-tara ni sunde imasu.",
          "si": "මම මාතර ජීවත් වෙනවා."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    },
    {
      "id": "l04-grammar-04",
      "jp": "N1 の N2",
      "romaji": "N1 no N2",
      "explanation_si": "の මඟින් නාම පද දෙකක් අතර අයිතිය, සම්බන්ධතාව හෝ විස්තරය දක්වයි. 'මගේ පවුල', 'අක්කාගේ දරුවා' වැනි අදහස්. සමහර විට නාම දෙක එකම පුද්ගලයා/දේ හඳුන්වයි.",
      "examples": [
        {
          "ja": "私の家族です。",
          "romaji": "Watashi no kazoku desu.",
          "si": "මේ මගේ පවුලයි."
        }
      ],
      "source_status": "checked_against_official_grammar_notes"
    }
  ],
